<h1>Manage Users</h1>
<table>
  <thead>
    <tr><th>ID</th><th>Username</th><th>Email</th><th>Role</th></tr>
  </thead>
  <tbody>
    {{#each users}}
      <tr>
        <td>{{id}}</td>
        <td>{{username}}</td>
        <td>{{email}}</td>
        <td>{{role}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>
