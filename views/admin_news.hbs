<h1>Manage News</h1>
<table>
  <thead>
    <tr><th>ID</th><th>Title</th><th>Date</th><th>Author</th></tr>
  </thead>
  <tbody>
    {{#each news}}
      <tr>
        <td>{{id}}</td>
        <td>{{title}}</td>
        <td>{{date}}</td>
        <td>{{author}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>
